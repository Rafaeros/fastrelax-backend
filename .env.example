DB_URL=jdbc:postgresql://localhost:5432/<database>
DB_USER=username
DB_PASS=password
JWT_SECRET=sha256_key
AES_SECRET=aes_key

# Segredo compartilhado com o firmware do ESP32. O dispositivo envia em
# X-Device-Token no heartbeat, e a API envia de volta nos comandos do relé.
CHAIR_DEVICE_TOKEN=troque-este-token

# Origens liberadas no navegador, separadas por vírgula. Aceita curinga (*) no
# host e na porta. Mantenha apenas a máquina local e a rede interna: a API não
# deve ser alcançável de fora.
#   http://localhost         -> Next em dev na porta 80
#   http://localhost:*       -> qualquer porta local (3000, 5173...)
#   http://192.168.*.*:*     -> rede da empresa
#   http://10.*.*.*:*        -> outra faixa privada comum
# Se a rede usar a faixa 172.16–172.31, acrescente as sub-redes em uso
# (ex.: http://172.20.*.*:*).
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:*,http://127.0.0.1:*,http://192.168.*.*:*,http://10.*.*.*:*

# =========================================================================
# RABBITMQ / MQTT — comandos de cadeira, transporte alternativo ao HTTP
# =========================================================================
# Desligado por padrão: enquanto false, ChairClient usa só HTTP e o backend
# não abre conexão nenhuma com o RabbitMQ (nem fila, nem binding são
# declarados). Só ligue depois de confirmar que uma cadeira de verdade fala
# MQTT (MQTT_ENABLED=1 no config.h dela).
MQTT_ENABLED=false

# Mesmo host/usuário/senha que o firmware usa em MQTT_HOST/MQTT_USERNAME/
# MQTT_PASSWORD no config.h — o backend fala AMQP nativo com o broker
# (porta 5672), o firmware fala MQTT puro (porta 1883); o plugin
# rabbitmq_mqtt do RabbitMQ traduz um lado pro outro.
MQTT_HOST=localhost
MQTT_USERNAME=fastrelax
MQTT_PASSWORD=troque-esta-senha
RABBITMQ_AMQP_PORT=5672
RABBITMQ_VHOST=/

# Porta que as cadeiras (ESP32) falam — usada só para popular POST /mqtt de
# uma cadeira sem override próprio. Mesmo host/usuário/senha acima.
MQTT_DEVICE_PORT=1883

# Precisa bater com MQTT_TOPIC_PREFIX no config.h do firmware.
MQTT_TOPIC_PREFIX=fastrelax/chairs

# Quanto esperar pelo ack via MQTT antes de considerar a cadeira sem
# resposta (a viagem passa pelo broker, por isso é mais folgado que o
# timeout HTTP).
MQTT_COMMAND_TIMEOUT_MS=5000

# =========================================================================
# NOTIFICAÇÕES PUSH — lembrete de sessão no navegador e no app Capacitor
# =========================================================================
# Chaves VAPID do Web Push (navegador). Gere um par próprio, por exemplo com
# `npx web-push generate-vapid-keys`. Vazio desativa o envio por essa via
# sem quebrar nada — a notificação só não sai.
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=mailto:ti@suaempresa.com

# Caminho do JSON de credenciais de uma service account do Firebase, para
# push no app Android/iOS via FCM. Vazio desativa o envio por essa via.
FCM_CREDENTIALS_FILE=

# =========================================================================
# E-MAIL — convite de primeiro acesso e recuperação de senha
# =========================================================================
# Desligado, o cadastro cai na senha temporária exibida na tela e o corpo das
# mensagens vai para o log em DEBUG. Ligue só depois de preencher o restante.
MAIL_ENABLED=false

# SMTP do Gmail. MAIL_PASSWORD é a *senha de app* de 16 caracteres gerada em
#   https://myaccount.google.com/apppasswords
# A senha da conta não funciona, e a página só aparece com a verificação em
# duas etapas ligada. Gere uma por ambiente: revogar a de homologação não pode
# derrubar produção.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=contato@suaempresa.com
MAIL_PASSWORD=abcd efgh ijkl mnop

# Remetente. No Gmail precisa ser a mesma conta de MAIL_USERNAME — o servidor
# recusa um From de outro domínio.
MAIL_FROM=contato@suaempresa.com
MAIL_FROM_NAME=FastRelax

# Base pública do frontend, usada para montar os links dos e-mails. Precisa ser
# o endereço que a *pessoa* abre no navegador, não o que o servidor alcança.
WEB_BASE_URL=http://localhost
